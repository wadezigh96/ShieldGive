PORT=3001
POLL_INTERVAL_SECONDS=30

# Durable production storage. A production server refuses to start without this.
# Use the PostgreSQL URL supplied by your hosting/database provider.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DB_POOL_MAX=5

# LIVE Zcash mode:
ZCASH_MODE=live
ZCASH_RPC_URL=http://127.0.0.1:8232
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=
ZCASH_MIN_CONFIRMATIONS=1
# Optional override, if your node/provider exposes a different compatible method:
ZCASH_RPC_METHOD=z_listreceivedbyaddress
CAMPAIGN_SHIELDED_ADDRESS=

# LIVE Solana mode:
SOLANA_MODE=live
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_LIVE_MINT_ENABLED=false
# Base58 Solana secret key OR JSON array secret key. NEVER commit this value.
SOLANA_PRIVATE_KEY=
# URI to immutable/public NFT metadata JSON.
SOLANA_NFT_METADATA_URI=
SOLANA_NFT_NAME=ShieldGive Donation Proof
SOLANA_NFT_SYMBOL=SGIVE
